diff --git a/src/JunimoGate.App/ManageModsShortcutActivity.cs b/src/JunimoGate.App/ManageModsShortcutActivity.cs
new file mode 100644
index 0000000..172fe1c
--- /dev/null
+++ b/src/JunimoGate.App/ManageModsShortcutActivity.cs
@@ -0,0 +1,27 @@
+using Android.App;
+using Android.Content;
+using Android.OS;
+
+namespace JunimoGate.App;
+
+// Android static shortcuts carry CLEAR_TASK. Keep that flag in a disposable
+// task with no affinity, then route to the manager without forwarding it.
+[Activity(
+    Name = "org.junimogate.app.ManageModsShortcutActivity",
+    Label = "Manage mods",
+    Theme = "@android:style/Theme.NoDisplay",
+    Exported = true,
+    TaskAffinity = "",
+    NoHistory = true,
+    ExcludeFromRecents = true)]
+public sealed class ManageModsShortcutActivity : Activity
+{
+    protected override void OnCreate(Bundle? savedInstanceState)
+    {
+        base.OnCreate(savedInstanceState);
+        var manager = new Intent(this, typeof(MainActivity));
+        manager.AddFlags(ActivityFlags.NewTask);
+        StartActivity(manager);
+        Finish();
+    }
+}
