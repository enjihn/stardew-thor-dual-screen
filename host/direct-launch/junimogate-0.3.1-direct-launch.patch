+++ b/src/JunimoGate.App/DirectLaunchActivity.cs
@@ -0,0 +1,124 @@
+using Android.App;
+using Android.Content;
+using Android.Content.PM;
+using Android.Graphics;
+using Android.OS;
+using Android.Views;
+using Android.Widget;
+using JunimoGate.GameHost;
+using Log = JunimoGate.Android.JunimoGateLog;
+using OperationCanceledException = System.OperationCanceledException;
+
+namespace JunimoGate.App;
+
+/// <summary>A direct game entry using the same preparation and launch registry as the manager.</summary>
+[Activity(
+    Name = "org.junimogate.app.DirectLaunchActivity",
+    Label = "Stardew Dual Screen",
+    Icon = "@drawable/thor_launcher_icon",
+    Theme = "@style/Theme.Thor.DirectLaunch",
+    MainLauncher = true,
+    Exported = true,
+    LaunchMode = LaunchMode.SingleTop,
+    ScreenOrientation = ScreenOrientation.SensorLandscape)]
+[MetaData("android.app.shortcuts", Resource = "@xml/thor_shortcuts")]
+public sealed class DirectLaunchActivity : Activity
+{
+    private CancellationTokenSource? lifetime;
+    private LauncherCoordinator? coordinator;
+    private TextView? status;
+    private Button? manage;
+    private bool dispatched;
+    private bool destroyed;
+
+    protected override void OnCreate(Bundle? savedInstanceState)
+    {
+        base.OnCreate(savedInstanceState);
+        Log.Initialize(this, "launcher", GameHostRuntimeIdentity.BuildId);
+        if (GameSessionRegistry.TryRouteActiveGame(this))
+        {
+            Log.Info("JunimoGate.DirectLaunch", "resumed-active-game");
+            Finish();
+            return;
+        }
+
+        var layout = new LinearLayout(this) { Orientation = Orientation.Vertical };
+        layout.SetGravity(GravityFlags.Center);
+        layout.SetPadding(48, 48, 48, 48);
+        var title = new TextView(this) { Text = "Stardew Valley", TextSize = 30, Gravity = GravityFlags.Center };
+        title.SetTextColor(Color.White);
+        layout.AddView(title);
+        status = new TextView(this) { Text = "Starting dual screen...", TextSize = 16, Gravity = GravityFlags.Center };
+        status.SetTextColor(Color.White);
+        status.SetPadding(0, 24, 0, 24);
+        layout.AddView(status);
+        manage = new Button(this) { Text = "Open mod manager", Visibility = ViewStates.Gone };
+        manage.Click += (_, _) => { StartActivity(new Intent(this, typeof(MainActivity))); Finish(); };
+        layout.AddView(manage);
+        SetContentView(layout);
+
+        lifetime = new CancellationTokenSource();
+        coordinator = new LauncherCoordinator(ApplicationContext ?? this);
+        _ = PrepareAndLaunchAsync(lifetime.Token);
+    }
+
+    protected override void OnNewIntent(Intent? intent)
+    {
+        base.OnNewIntent(intent);
+        // A repeated icon press shares the in-flight operation or resumes the live game.
+        if (!destroyed && GameSessionRegistry.TryRouteActiveGame(this)) Finish();
+    }
+
+    private async Task PrepareAndLaunchAsync(CancellationToken cancellationToken)
+    {
+        try
+        {
+            var launcher = coordinator!;
+            var handle = await launcher.InitializeAsync(cancellationToken);
+            handle ??= await launcher.TryCreateLaunchAsync(cancellationToken);
+            // A changed active snapshot/profile can finish refreshing without issuing a handle.
+            if (handle is null && launcher.CurrentState.Status == LauncherStatus.Ready)
+                handle = await launcher.TryCreateLaunchAsync(cancellationToken);
+            if (destroyed || cancellationToken.IsCancellationRequested) return;
+            if (handle is null)
+            {
+                ShowFailure(LauncherTextFormatter.Format(this, launcher.CurrentState));
+                return;
+            }
+            if (dispatched) return;
+            var intent = new Intent(this, typeof(SmapiGameActivity));
+            intent.PutExtra(SmapiGameActivity.LaunchKeyExtra, handle.Key);
+            var options = ActivityOptions.MakeBasic();
+            options.SetLaunchDisplayId(global::Android.Views.Display.DefaultDisplay);
+            Log.Info("JunimoGate.DirectLaunch", "dispatch-game-without-manager");
+            StartActivity(intent, options.ToBundle());
+            dispatched = true;
+            Finish();
+        }
+        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
+        catch (Exception exception) when (exception is ActivityNotFoundException or InvalidOperationException or IOException)
+        {
+            Log.Error("JunimoGate.DirectLaunch", "direct-launch-failed", exception);
+            if (!destroyed) ShowFailure("The game could not start. Open the mod manager to check its status.");
+        }
+    }
+
+    private void ShowFailure(string message)
+    {
+        if (status is not null) status.Text = message;
+        if (manage is not null) manage.Visibility = ViewStates.Visible;
+    }
+
+    protected override void OnDestroy()
+    {
+        destroyed = true;
+        lifetime?.Cancel();
+        lifetime?.Dispose();
+        lifetime = null;
+        coordinator?.Dispose();
+        coordinator = null;
+        status = null;
+        manage = null;
+        base.OnDestroy();
+    }
+}
