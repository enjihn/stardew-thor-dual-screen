diff --git a/FashionSense/Framework/Patches/Menus/CharacterCustomizationPatch.cs b/FashionSense/Framework/Patches/Menus/CharacterCustomizationPatch.cs
--- a/FashionSense/Framework/Patches/Menus/CharacterCustomizationPatch.cs
+++ b/FashionSense/Framework/Patches/Menus/CharacterCustomizationPatch.cs
@@ -23,6 +23,12 @@ namespace FashionSense.Framework.Patches.Menus
 
         internal void Apply(Harmony harmony)
         {
+            // Android uses MobileCustomizer instead of the desktop character creation UI.
+            // Skip only the optional desktop starting-mirror checkbox hooks.
+            if (AccessTools.TypeByName("StardewValley.Menus.MobileCustomizer") is not null)
+            {
+                return;
+            }
             harmony.Patch(AccessTools.Method(_menu, "ResetComponents", null), postfix: new HarmonyMethod(GetType(), nameof(ResetComponentsPostfix)));
             harmony.Patch(AccessTools.Method(_menu, "selectionClick", new[] { typeof(string), typeof(int) }), postfix: new HarmonyMethod(GetType(), nameof(SelectionClickPostfix)));
 
